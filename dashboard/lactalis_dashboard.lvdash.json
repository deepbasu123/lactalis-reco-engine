{
  "datasets": [
    {
      "name": "orders_agg",
      "displayName": "Orders Analytics",
      "queryLines": [
        "\n",
        "    SELECT \n",
        "      segment_label,\n",
        "      brand,\n",
        "      category,\n",
        "      channel,\n",
        "      DATE_TRUNC('MONTH', order_date) as order_month,\n",
        "      SUM(line_revenue) as total_revenue,\n",
        "      COUNT(DISTINCT order_id) as order_count,\n",
        "      SUM(quantity) as total_quantity,\n",
        "      COUNT(DISTINCT customer_id) as customer_count\n",
        "    FROM lactalis_catalog.reco.vw_orders_enriched\n",
        "    GROUP BY segment_label, brand, category, channel, DATE_TRUNC('MONTH', order_date)\n",
        "    "
      ]
    },
    {
      "name": "kpi_totals",
      "displayName": "KPI Totals",
      "queryLines": [
        "\n",
        "    SELECT \n",
        "      SUM(line_revenue) as total_revenue,\n",
        "      COUNT(*) as order_line_count,\n",
        "      COUNT(DISTINCT customer_id) as active_customers\n",
        "    FROM lactalis_catalog.reco.vw_orders_enriched\n",
        "    "
      ]
    },
    {
      "name": "reco_by_trigger",
      "displayName": "Recommendations by Trigger",
      "queryLines": [
        "\n",
        "    SELECT \n",
        "      trigger_signal,\n",
        "      reco_type,\n",
        "      COUNT(*) as reco_count\n",
        "    FROM lactalis_catalog.reco.reco_candidates\n",
        "    GROUP BY trigger_signal, reco_type\n",
        "    "
      ]
    },
    {
      "name": "reco_summary",
      "displayName": "Recommendation Summary",
      "queryLines": [
        "\n",
        "    SELECT \n",
        "      COUNT(*) as total_recommendations,\n",
        "      COUNT(DISTINCT customer_id) as reco_customers,\n",
        "      SUM(CASE WHEN in_stock THEN 1 ELSE 0 END) as in_stock_count\n",
        "    FROM lactalis_catalog.reco.reco_candidates rc\n",
        "    LEFT JOIN lactalis_catalog.reco.stock_by_dc sdc \n",
        "      ON rc.product_id = sdc.product_id\n",
        "    "
      ]
    },
    {
      "name": "fulfilment_rate",
      "displayName": "Fulfilment Stats",
      "queryLines": [
        "\n",
        "    SELECT \n",
        "      COUNT(CASE WHEN in_stock THEN 1 END) as in_stock_count,\n",
        "      COUNT(*) as total_products_dcs\n",
        "    FROM lactalis_catalog.reco.stock_by_dc\n",
        "    "
      ]
    },
    {
      "name": "out_of_stock",
      "displayName": "Out of Stock Products",
      "queryLines": [
        "\n",
        "    SELECT \n",
        "      sdc.dc_id,\n",
        "      dp.product_name,\n",
        "      COUNT(*) as count\n",
        "    FROM lactalis_catalog.reco.stock_by_dc sdc\n",
        "    LEFT JOIN lactalis_catalog.reco.dim_dc dd ON sdc.dc_id = dd.dc_id\n",
        "    LEFT JOIN lactalis_catalog.reco.dim_product dp ON sdc.product_id = dp.product_id\n",
        "    WHERE sdc.in_stock = false\n",
        "    GROUP BY sdc.dc_id, dp.product_name\n",
        "    LIMIT 10\n",
        "    "
      ]
    },
    {
      "name": "revenue_by_segment",
      "displayName": "Revenue by Segment",
      "queryLines": [
        "\n",
        "    SELECT \n",
        "      segment_label,\n",
        "      SUM(line_revenue) as segment_revenue\n",
        "    FROM lactalis_catalog.reco.vw_orders_enriched\n",
        "    GROUP BY segment_label\n",
        "    ORDER BY segment_revenue DESC\n",
        "    "
      ]
    },
    {
      "name": "revenue_by_brand",
      "displayName": "Revenue by Brand",
      "queryLines": [
        "\n",
        "    SELECT \n",
        "      brand,\n",
        "      SUM(line_revenue) as brand_revenue\n",
        "    FROM lactalis_catalog.reco.vw_orders_enriched\n",
        "    GROUP BY brand\n",
        "    ORDER BY brand_revenue DESC\n",
        "    "
      ]
    },
    {
      "name": "category_mix",
      "displayName": "Category Mix",
      "queryLines": [
        "\n",
        "    SELECT \n",
        "      category,\n",
        "      COUNT(*) as category_count\n",
        "    FROM lactalis_catalog.reco.vw_orders_enriched\n",
        "    GROUP BY category\n",
        "    "
      ]
    },
    {
      "name": "reco_by_type_segment",
      "displayName": "Recommendations by Type and Segment",
      "queryLines": [
        "\n",
        "    SELECT \n",
        "      rc.reco_type,\n",
        "      oe.segment_label,\n",
        "      COUNT(*) as reco_count\n",
        "    FROM lactalis_catalog.reco.reco_candidates rc\n",
        "    JOIN lactalis_catalog.reco.vw_orders_enriched oe ON rc.customer_id = oe.customer_id\n",
        "    GROUP BY rc.reco_type, oe.segment_label\n",
        "    "
      ]
    }
  ],
